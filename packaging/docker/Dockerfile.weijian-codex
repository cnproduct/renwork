# syntax=docker/dockerfile:1.7
FROM node:22-bookworm-slim
RUN corepack enable
WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml /app/
COPY patches /app/patches
COPY ee/apps/weijian-codex-worker/package.json /app/ee/apps/weijian-codex-worker/package.json
RUN pnpm install --frozen-lockfile --filter @openwork-ee/weijian-codex-worker --prod
COPY ee/apps/weijian-codex-worker/server.mjs /app/ee/apps/weijian-codex-worker/server.mjs
RUN mkdir -p /data /run/codex && chown node:node /data /run/codex
ENV PORT=8795
ENV RENWORK_CODEX_BIN=/app/ee/apps/weijian-codex-worker/node_modules/.bin/codex
ENV RENWORK_CODEX_TMP_ROOT=/run/codex
USER node
EXPOSE 8795
HEALTHCHECK --interval=30s --timeout=5s --retries=3 CMD node -e "fetch('http://127.0.0.1:8795/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "/app/ee/apps/weijian-codex-worker/server.mjs"]
