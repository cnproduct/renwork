# Copy to .env.account on the Tencent host. Never commit the real file.
RENWORK_RELEASE_VERSION=0.18.51
MYSQL_ROOT_PASSWORD=
DB_PASSWORD=
REDIS_PASSWORD=
BETTER_AUTH_SECRET=
DEN_DB_ENCRYPTION_KEY=

# Configure either Resend or SMTP. Production OTP is blocked without one.
EMAIL_FROM='RenWork <noreply@rrenn.com>'
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

# Buyer data remains fail-closed until an organization is explicitly bound.
RENWORK_BUYER_PROVIDER_MODE=disabled
RENWORK_HUNTER_API_KEY=
RENWORK_HUNTER_ALLOWED_ORG_ID=
RENWORK_HUNTER_OFFICIAL_POOL_LICENSED=0
